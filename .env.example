# ==============================================================================
# 80/20 OUTBOUND SYSTEM - PRODUCTION & NETLIFY ENVIRONMENT CONFIGURATION
# Copy these keys into your Netlify Project Settings -> Environment Variables.
# IMPORTANT: Never commit actual secret keys or values into Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Set to your live Netlify production URL (e.g., https://your-site.netlify.app)
APP_URL=https://your-site.netlify.app
PUBLIC_URL=https://your-site.netlify.app

# ------------------------------------------------------------------------------
# 2. SUPABASE (DATABASE & REALTIME ENGINE)
# ------------------------------------------------------------------------------
# Found in your Supabase project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Client-side Realtime WebSockets (Optional - for cross-device live bus)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Must be a secure random 32+ character string in production
JWT_SECRET=generate_a_random_32_character_secret_key_here

# ------------------------------------------------------------------------------
# 4. TWILIO TELEPHONY (VOICE CALLS & SMS)
# ------------------------------------------------------------------------------
# Twilio Console -> Account Info
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Twilio API Key & Secret for WebRTC Voice SDK softphone tokens (Console -> API Keys)
TWILIO_API_KEY=SKXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_TWIML_APP_SID=APXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# 5. RESEND (EMAIL DELIVERY & WEBHOOKS)
# ------------------------------------------------------------------------------
# Resend Dashboard -> API Keys (re_...)
RESEND_API_KEY=re_your_resend_api_key
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret

# Default outbound sender and reply-to configuration
EMAIL_FROM=outreach@your-verified-domain.com
EMAIL_FROM_NAME=80/20 Acquisition
REPLY_TO=replies@your-verified-domain.com
EMAIL_ALLOWED_DOMAINS=your-verified-domain.com

# ------------------------------------------------------------------------------
# 6. AI PERSONALIZATION (ANTHROPIC CLAUDE)
# ------------------------------------------------------------------------------
# Anthropic Console -> API Keys (sk-ant-...)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# ------------------------------------------------------------------------------
# 7. DISTRIBUTED RATE LIMITING (OPTIONAL - UPSTASH REDIS)
# ------------------------------------------------------------------------------
# If left empty, system automatically uses in-memory rate limiting with lockout
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 8. LISTMONK SMTP (OPTIONAL)
# ------------------------------------------------------------------------------
LISTMONK_URL=http://localhost:9001
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASS=
